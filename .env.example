# =============================================================================
# Autonomous Healthcare Platform Configuration (.env.example)
# =============================================================================

# Project
PROJECT_NAME="Autonomous Healthcare Intake & Scheduling Platform"
ENVIRONMENT="development"
DEBUG=True

# Database (Use PostgreSQL in production/Docker, or SQLite for zero-setup local runs)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/healthcare_db
# DATABASE_URL=sqlite+aiosqlite:///./healthcare_platform.db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Google Gemini API (Leave blank to use deterministic simulation mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Redis Cache / Background Workers
REDIS_URL=redis://redis:6379/0

# SMTP Email Notification Provider (Mocked by default)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@healthcareplatform.local
SMTP_PASSWORD=change-me
EMAILS_FROM_EMAIL=no-reply@healthcareplatform.local

# Mock EHR Connector Settings
EHR_BASE_URL=http://backend:8000/mock-ehr
EHR_API_KEY=mock-ehr-secret-key
EHR_TIMEOUT_SECONDS=3.0
